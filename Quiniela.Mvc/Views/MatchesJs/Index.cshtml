@model MatchesJsIndexViewModel

@{
    ViewData["Title"] = "Matches JavaScript";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1>Matches JavaScript</h1>
        <p class="text-muted mb-0">Select a match in the top grid to refresh its details below.</p>
    </div>
    <a asp-controller="MatchesApi" asp-action="Create" class="btn btn-primary">Insert match</a>
</div>

<form id="matches-js-filters" class="row g-3 align-items-end mb-3">
    <div class="col-md-4">
        <label for="matches-js-tournament" class="form-label">Tournament</label>
        <select id="matches-js-tournament" name="tournamentId" asp-items="Model.Tournaments" class="form-select">
            <option value="">All tournaments</option>
        </select>
    </div>
    <div class="col-md-4">
        <label for="matches-js-team" class="form-label">Team</label>
        <select id="matches-js-team" name="teamId" asp-items="Model.Teams" class="form-select">
            <option value="">All teams</option>
        </select>
    </div>
    <div class="col-md-2">
        <label for="matches-js-page-size" class="form-label">Page size</label>
        <input id="matches-js-page-size" name="pageSize" type="number" min="1" max="100"
               value="@Model.PageSize" class="form-control" />
    </div>
    <div class="col-md-2 d-flex gap-2">
        <button type="submit" class="btn btn-outline-primary">Apply</button>
        <button id="matches-js-clear" type="button" class="btn btn-outline-secondary">Clear</button>
    </div>
</form>

<section class="card mb-4" aria-labelledby="matches-grid-heading">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h2 id="matches-grid-heading" class="h5 mb-0">Matches</h2>
        <button id="matches-js-refresh" type="button" class="btn btn-sm btn-outline-primary">Refresh</button>
    </div>
    <div class="card-body">
        <div id="matches-js-status" class="text-muted mb-2" role="status" aria-live="polite"></div>
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Match</th>
                        <th>Tournament</th>
                        <th>Kind</th>
                        <th>Sport</th>
                        <th>Played at</th>
                        <th>Status</th>
                        <th>Score</th>
                    </tr>
                </thead>
                <tbody id="matches-js-grid">
                    <tr><td colspan="7" class="text-muted">Loading matches…</td></tr>
                </tbody>
            </table>
        </div>
        <div class="d-flex justify-content-between align-items-center mt-3">
            <button id="matches-js-previous" type="button" class="btn btn-outline-secondary">Previous</button>
            <span id="matches-js-page" class="text-muted"></span>
            <button id="matches-js-next" type="button" class="btn btn-outline-secondary">Next</button>
        </div>
    </div>
</section>

<section class="card" aria-labelledby="match-detail-heading">
    <div class="card-header">
        <h2 id="match-detail-heading" class="h5 mb-0">Match details and forecasts</h2>
    </div>
    <div id="matches-js-detail" class="card-body">
        <p class="text-muted mb-0">Select a match above to see its details and forecasts.</p>
    </div>
</section>

<div id="matches-js-endpoints"
     data-matches-url="@Model.MatchesUrl"
     data-match-url="@Model.MatchUrl"
     data-details-url="@Url.Action("Details", "MatchesApi")"
     data-edit-url="@Url.Action("Edit", "MatchesApi")"
     data-delete-url="@Url.Action("Delete", "MatchesApi")"
     data-stats-url="@Url.Action("Stats", "MatchesApi")"></div>

@section Scripts {
    <script src="~/js/matches-js.js" asp-append-version="true"></script>
}
