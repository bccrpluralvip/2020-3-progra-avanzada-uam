@{
    ViewData["Title"] = "Quiniela";
}

<div class="text-center py-5">
    <div class="card shadow-sm border-0 mx-auto" style="max-width: 700px;">
        <div class="card-body p-5">
            <p class="text-primary fw-semibold text-uppercase letter-spacing">Quiniela System</p>
            <h1 class="display-5 fw-bold mb-3">Hello, system!</h1>
            <p class="lead text-secondary mb-4">
                Welcome to the quiniela scoring experience. You can calculate points from real and guessed match results in a few steps.
            </p>
            <a asp-action="WebUnitTesting" class="btn btn-primary btn-lg">Go to web unit testing</a>
        </div>
    </div>
</div>
