@model Quiniela.Mvc.Models.QuinielaScoreViewModel
@{
    ViewData["Title"] = "Web Unit Testing";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4 p-md-5">
                <h1 class="mb-4">Web Unit Testing</h1>

                <form asp-action="WebUnitTesting" method="post">
                    @Html.AntiForgeryToken()

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="RealTeamAScore" class="form-label">Real team A score</label>
                            <input asp-for="RealTeamAScore" class="form-control" type="number" min="0" required />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="RealTeamBScore" class="form-label">Real team B score</label>
                            <input asp-for="RealTeamBScore" class="form-control" type="number" min="0" required />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="GuessedTeamAScore" class="form-label">Guessed team A score</label>
                            <input asp-for="GuessedTeamAScore" class="form-control" type="number" min="0" required />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="GuessedTeamBScore" class="form-label">Guessed team B score</label>
                            <input asp-for="GuessedTeamBScore" class="form-control" type="number" min="0" required />
                        </div>
                    </div>

                    <div class="d-grid mt-4">
                        <button type="submit" class="btn btn-primary btn-lg">Submit</button>
                    </div>
                </form>

                @if (Model.TotalPoints.HasValue)
                {
                    <div class="alert alert-success mt-4 mb-0">
                        Given the previous arguments, the total of points is @Model.TotalPoints.
                    </div>
                }
            </div>
        </div>
    </div>
</div>
