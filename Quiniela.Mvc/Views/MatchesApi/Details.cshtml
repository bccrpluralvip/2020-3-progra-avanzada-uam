@model Quiniela.Mvc.Models.MatchApiDetailsViewModel

@{
    ViewData["Title"] = $"Match {Model.MatchId}";
}

<h1>Match @Model.MatchId</h1>
<dl class="row">
    <dt class="col-sm-3">Tournament</dt>
    <dd class="col-sm-9">@(Model.TournamentName ?? "—")</dd>
    <dt class="col-sm-3">Match kind</dt>
    <dd class="col-sm-9">@Model.MatchKind</dd>
    <dt class="col-sm-3">Sport</dt>
    <dd class="col-sm-9">@Model.Sport</dd>
    <dt class="col-sm-3">Home team</dt>
    <dd class="col-sm-9">@Model.HomeTeamName</dd>
    <dt class="col-sm-3">Away team</dt>
    <dd class="col-sm-9">@Model.AwayTeamName</dd>
    <dt class="col-sm-3">Played at</dt>
    <dd class="col-sm-9">@Model.PlayedAt.LocalDateTime.ToString("f")</dd>
    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">@Model.Status</dd>
    <dt class="col-sm-3">Score</dt>
    <dd class="col-sm-9">@(Model.HomeScore?.ToString() ?? "—") – @(Model.AwayScore?.ToString() ?? "—")</dd>
</dl>

<h2>Forecasts</h2>
@if (Model.Forecasts.Count == 0)
{
    <p class="text-muted">No forecasts have been submitted.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>User id</th>
                    <th>Predicted home score</th>
                    <th>Predicted away score</th>
                    <th>Submitted at</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var forecast in Model.Forecasts)
            {
                <tr>
                    <td>@forecast.UserId</td>
                    <td>@forecast.PredictedHomeScore</td>
                    <td>@forecast.PredictedAwayScore</td>
                    <td>@forecast.SubmittedAt.LocalDateTime.ToString("g")</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

<div class="d-flex gap-2 mt-4">
    <a asp-action="Edit" asp-route-id="@Model.MatchId" class="btn btn-primary">Edit</a>
    <a asp-action="Delete" asp-route-id="@Model.MatchId" class="btn btn-outline-danger">Delete</a>
    <a asp-action="Stats" asp-route-id="@Model.MatchId" target="_blank" rel="noopener noreferrer" class="btn btn-outline-secondary">View JSON stats</a>
    <a asp-action="Index" class="btn btn-link">Back to matches</a>
</div>
