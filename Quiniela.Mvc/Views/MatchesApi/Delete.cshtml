@model Quiniela.Mvc.Models.MatchApiDeleteViewModel

@{
    ViewData["Title"] = "Delete match";
}

<h1>Delete match</h1>
<div class="alert alert-warning">
    Delete match @Model.MatchId, @Model.HomeTeamName vs @Model.AwayTeamName?
    Its forecasts will also be deleted.
</div>
<dl class="row">
    <dt class="col-sm-3">Tournament</dt>
    <dd class="col-sm-9">@(Model.TournamentName ?? "—")</dd>
    <dt class="col-sm-3">Played at</dt>
    <dd class="col-sm-9">@Model.PlayedAt.LocalDateTime.ToString("f")</dd>
    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">@Model.Status</dd>
</dl>
<form asp-action="Delete" asp-route-id="@Model.MatchId" method="post">
    <button type="submit" class="btn btn-danger">Confirm delete</button>
    <a asp-action="Details" asp-route-id="@Model.MatchId" class="btn btn-outline-secondary">Cancel</a>
</form>
