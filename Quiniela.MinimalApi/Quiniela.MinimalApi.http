@baseUrl = http://localhost:5052/api

### Get a page of forecasts
GET {{baseUrl}}/forecasts

### Get a forecast
GET {{baseUrl}}/forecasts/1

### Create a forecast
POST {{baseUrl}}/forecasts
Content-Type: application/json

{
  "userId": 1,
  "matchId": 1,
  "predictedHomeScore": 2,
  "predictedAwayScore": 1,
  "submittedAt": "2026-10-17T17:30:00Z"
}

### Replace a forecast
PUT {{baseUrl}}/forecasts/1
Content-Type: application/json

{
  "userId": 1,
  "matchId": 1,
  "predictedHomeScore": 1,
  "predictedAwayScore": 1,
  "submittedAt": "2026-10-17T17:30:00Z"
}

### Delete a forecast
DELETE {{baseUrl}}/forecasts/1

### Get a page of matches
GET {{baseUrl}}/matches

### Get a match
GET {{baseUrl}}/matches/1

### Create a match
POST {{baseUrl}}/matches
Content-Type: application/json

{
  "tournamentId": 1,
  "matchKind": "Official",
  "sport": "Soccer",
  "homeTeamId": 1,
  "awayTeamId": 2,
  "playedAt": "2026-10-17T18:30:00Z",
  "status": "Scheduled",
  "homeScore": null,
  "awayScore": null,
  "statsJson": {}
}

### Replace a match
PUT {{baseUrl}}/matches/1
Content-Type: application/json

{
  "tournamentId": 1,
  "matchKind": "Official",
  "sport": "Soccer",
  "homeTeamId": 1,
  "awayTeamId": 2,
  "playedAt": "2026-10-17T18:30:00Z",
  "status": "Live",
  "homeScore": null,
  "awayScore": null,
  "statsJson": {}
}

### Delete a match
DELETE {{baseUrl}}/matches/1

### Get a page of teams
GET {{baseUrl}}/teams

### Get a team
GET {{baseUrl}}/teams/1

### Create a team
POST {{baseUrl}}/teams
Content-Type: application/json

{
  "name": "Example City",
  "shortName": "EXC",
  "sport": "Soccer"
}

### Replace a team
PUT {{baseUrl}}/teams/1
Content-Type: application/json

{
  "name": "Example City",
  "shortName": "EXC",
  "sport": "Soccer"
}

### Delete a team
DELETE {{baseUrl}}/teams/1

### Get a page of tournaments
GET {{baseUrl}}/tournaments

### Get a tournament
GET {{baseUrl}}/tournaments/1

### Create a tournament
POST {{baseUrl}}/tournaments
Content-Type: application/json

{
  "name": "Example League",
  "season": "2026",
  "sport": "Soccer"
}

### Replace a tournament
PUT {{baseUrl}}/tournaments/1
Content-Type: application/json

{
  "name": "Example League",
  "season": "2026",
  "sport": "Soccer"
}

### Delete a tournament
DELETE {{baseUrl}}/tournaments/1

### Get a page of tournament participants
GET {{baseUrl}}/tournament-participants

### Get a tournament participant
GET {{baseUrl}}/tournament-participants/1

### Add a team to a tournament
POST {{baseUrl}}/tournament-participants
Content-Type: application/json

{
  "tournamentId": 1,
  "teamId": 1
}

### Replace a tournament participant
PUT {{baseUrl}}/tournament-participants/1
Content-Type: application/json

{
  "tournamentId": 1,
  "teamId": 2
}

### Remove a tournament participant
DELETE {{baseUrl}}/tournament-participants/1

### Get a page of users
GET {{baseUrl}}/users

### Get a user
GET {{baseUrl}}/users/1

### Create a user
POST {{baseUrl}}/users
Content-Type: application/json

{
  "username": "example-user",
  "email": "example@example.com"
}

### Replace a user
PUT {{baseUrl}}/users/1
Content-Type: application/json

{
  "username": "example-user",
  "email": "example@example.com"
}

### Delete a user
DELETE {{baseUrl}}/users/1

### Get a page of matches in a tournament (pageNumber and pageSize default to 1 and 10)
GET {{baseUrl}}/queries/matches/by-tournament/1

### Get a page of matches involving a team within an inclusive date range
GET {{baseUrl}}/queries/matches/by-team/1?from=2026-01-01T00:00:00Z&to=2026-12-31T23:59:59Z&pageNumber=1&pageSize=10
